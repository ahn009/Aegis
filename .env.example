# Development only. Copy to .env and set values for your environment.
# Prisma resolves relative SQLite paths from prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"
VELORA_AI_PROVIDER="mock"
VELORA_APP_BASE_URL="http://localhost:3000"

# Set unique, random values for production. Never commit them.
VELORA_ENCRYPTION_KEY=""
VELORA_SESSION_SECRET=""
VELORA_VERIFY_WEBHOOKS="1"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
OPENAI_API_KEY=""
